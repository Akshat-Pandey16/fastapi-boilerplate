# =============================================================================
# Application
# =============================================================================
ENVIRONMENT=local            # local | development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false               # set true in production for structured JSON logs

# =============================================================================
# API
# =============================================================================
API_TITLE=FastAPI Boilerplate
API_DESCRIPTION=Production-grade FastAPI boilerplate with async SQLAlchemy and Pydantic v2.
API_VERSION=0.1.0
API_PREFIX=/api
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true              # ignored outside development
API_WORKERS=1

# =============================================================================
# CORS (comma-separated, or "*" for any origin)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# Database
# =============================================================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fastapi_db

DB_ECHO=false                # log every SQL statement (noisy)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800         # seconds
DB_STATEMENT_TIMEOUT_MS=30000

# =============================================================================
# Security
# =============================================================================
SECRET_KEY=please-change-me-to-a-long-random-string
REQUEST_ID_HEADER=X-Request-ID
