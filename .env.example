# Copy to .env and edit. `make setup` does this for you and fills in a real
# SECRET_KEY and a database that works on your machine.
# Every value here is a default — delete a line and the app still starts.

# =============================================================================
# Application
# =============================================================================
ENVIRONMENT=local            # local | development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false               # true in production, for log aggregators

# =============================================================================
# API
# =============================================================================
API_TITLE=FastAPI Boilerplate
API_DESCRIPTION=Production-grade FastAPI boilerplate with async SQLAlchemy and Pydantic v2.
API_VERSION=0.1.0
API_PREFIX=/api
API_HOST=127.0.0.1           # 0.0.0.0 to accept connections from other machines
API_PORT=8000
API_RELOAD=false             # `make dev` reloads regardless
API_WORKERS=1                # used by `make run`; ignored when API_RELOAD=true

# =============================================================================
# CORS — needed only if a browser app on another origin calls this API
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=X-Request-ID,X-Response-Time-ms

# =============================================================================
# Database
#
# Pick a backend with DB_BACKEND, or set DATABASE_URL to a full DSN and every
# DB_* value below is ignored (this is what managed platforms inject).
#
#   sqlite    no server needed — only DB_SQLITE_PATH is read
#   postgres  the production default
#   mysql     needs `uv sync --extra mysql`
#   mongodb   needs `uv sync --extra mongodb`; Alembic does not apply
#
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
#   DATABASE_URL=mongodb://user:pass@host:27017
# =============================================================================
DB_BACKEND=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=                     # blank = the backend's default (5432/3306/27017)
DB_NAME=fastapi_db
DB_SQLITE_PATH=app.db        # only when DB_BACKEND=sqlite

DB_ECHO=false                # log every SQL statement (noisy)
DB_POOL_SIZE=10              # ignored by sqlite
DB_MAX_OVERFLOW=20           # ignored by sqlite
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800         # seconds
DB_STATEMENT_TIMEOUT_MS=30000  # PostgreSQL statement timeout / Mongo server selection timeout

# =============================================================================
# Security
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-me-to-a-long-random-string
REQUEST_ID_HEADER=X-Request-ID
